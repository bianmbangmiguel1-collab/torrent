# ============================================
# TORRENTTWIST - EXEMPLE DE CONFIGURATION
# ============================================
# Copiez ce fichier en .env.local et remplissez les valeurs

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=TorrentTwist
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# SÉCURITÉ - JWT
# ============================================
# Générer un secret avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# ============================================
# ADMIN
# ============================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password
ADMIN_NAME=Administrator

# ============================================
# SESSIONS
# ============================================
SESSION_TIMEOUT=1800000
MAX_LOGIN_ATTEMPTS=5

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-password
SMTP_FROM=no-reply@example.com

# ============================================
# IA - OpenRouter
# ============================================
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
USE_MOCK_AI=false

# ============================================
# IA - DeepSeek
# ============================================
DEEPSEEK_API_KEY=sk-xxx

# ============================================
# FEDAPAY
# ============================================
FEDAPAY_ENVIRONMENT=live
NEXT_PUBLIC_FEDAPAY_ENVIRONMENT=live
NEXT_PUBLIC_FEDAPAY_PUBLIC_KEY=pk_live_xxx
FEDAPAY_SECRET_KEY=sk_live_xxx
FEDAPAY_CALLBACK_URL=https://torrentwist.com/payment/success

# ============================================
# CHARIOW
# ============================================
CHARIOW_ENVIRONMENT=live
CHARIOW_API_URL=https://api.chariow.com/v1
CHARIOW_API_KEY=sk_xxx
CHARIOW_WEBHOOK_SECRET=whsec_xxx

# ============================================
# CLOUDINARY
# ============================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# ============================================
# SUPABASE
# ============================================
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# CORS
# ============================================
CORS_ORIGIN=https://torrentwist.com
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# ============================================
# SÉCURITÉ MOTS DE PASSE
# ============================================
BCRYPT_SALT_ROUNDS=10
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_UPPERCASE=true

# ============================================
# FICHIERS
# ============================================
MAX_FILE_SIZE=524288000
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
MAX_IMAGE_SIZE=10485760

# ============================================
# FEATURES
# ============================================
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_MAINTENANCE_MODE=false