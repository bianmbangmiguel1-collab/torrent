{
  "name": "torrentwist",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "d1faa1a56faa8b226dcfa45f515b8408",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "ADMIN_EMAIL": "admin@torrentwist.com",
    "CHARIOW_API_URL": "https://api.chariow.com/v1",
    "CHARIOW_GENERIC_PRODUCT_ID": "https://ztggdzzz.mychariow.com/prd_f8xlppea",
    "CORS_ORIGIN": "https://torrentwist.com",
    "NEXT_PUBLIC_API_URL": "https://torrentwist.com",
    "NEXTJS_SERVER_WORKING_DIRECTORY": "/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "torrenttwist-db",
      "database_id": "e97bc0a0-127a-4d94-8917-c76f5f779f55"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "653b9832d8604fa997eaa7b7b4bd0dc7"
    }
  ]
}